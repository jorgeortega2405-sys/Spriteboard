    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "multer": "^2.3.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cassandra-driver": "^4.1.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
