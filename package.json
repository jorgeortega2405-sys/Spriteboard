{
  "name": "spriteboard",
  "version": "1.0.0",
  "description": "Proyecto Node.js con TypeScript, MySQL y Docker",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'logs/**' --exclude 'dist/**' --exclude 'public/**' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cassandra-driver": "^4.7.2",
    "cookie-parser": "^1.4.7",
