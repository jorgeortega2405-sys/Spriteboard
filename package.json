{
  "name": "spriteboard",
  "version": "1.0.0",
  "description": "Proyecto Node.js con TypeScript, MySQL y Docker",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'logs/**' --exclude 'dist/**' --exclude 'client/**' --exclude 'public/**' --exclude 'data/**' --exclude 'worker/**' --exclude 'websocket/**' src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/index.js",
    "geoip:download": "tsx scripts/download-geoip.ts",
    "icons:bundle": "py admin_tool/manage_project.py"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bcryptjs": "^2.4.3",
    "cassandra-driver": "^4.7.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "maxmind": "^5.0.7",
    "multer": "^2.3.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "qr-code-styling": "^1.9.2",
    "sharp": "^0.35.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cassandra-driver": "^4.1.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  }
}
