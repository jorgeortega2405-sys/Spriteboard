# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
APP_NAME=Spriteboard
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ==========================================
# BASE DE DATOS (MYSQL)
# ==========================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=sprite_user
DB_PASSWORD=sprite_password
DB_NAME=db_identity

# ==========================================
# CACHÉ Y TEMPORALES (REDIS)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_FROM_NAME="Spriteboard"

# ==========================================
# SEGURIDAD Y SESIÓN
# ==========================================
SESSION_SECRET=cambiar_esta_clave_secreta_en_produccion
CSRF_SECRET=cambiar_esta_clave_csrf_en_produccion

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
