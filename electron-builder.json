{
  "appId": "com.spriteboard.desktop",
  "productName": "Spriteboard",
  "copyright": "Copyright © 2026 Spriteboard",
  "directories": {
    "output": "dist/installers"
  },
  "publish": {
    "provider": "github",
    "owner": "jorgeortega2405-sys",
    "repo": "Spriteboard"
  },
  "files": [
    "dist/desktop/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/desktop/main.js"
  },
  "protocols": [
    {
      "name": "Spriteboard",
      "schemes": ["spriteboard"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Spriteboard"
  }
}
